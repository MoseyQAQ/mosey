variable        NSTEPS          equal 50000
variable        THERMO_FREQ     equal 10
variable        DUMP_FREQ       equal 100
variable        TEMP            equal 300.0
variable        PRES            equal 0.0        # bar (metal units)
variable        TAU_T           equal 0.1        # ps
variable        TAU_P           equal 0.5        # ps
variable        DT              equal 0.002      # ps; 100 ps total

units           metal
boundary        p p p
atom_style      atomic

read_data       conf.lmp

pair_style      deepmd /org/wlu-liushi/lidenan/CZH_NNO/asset/compressed.pb
pair_coeff      * *

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

thermo_style    custom step time temp pe ke etotal press pxx pyy pzz vol lx ly lz xy xz yz
thermo          ${THERMO_FREQ}

dump            1 all custom ${DUMP_FREQ} traj.lammpstrj id type x y z
dump_modify     1 sort id

velocity        all create ${TEMP} 443428 mom yes rot no dist gaussian
fix             1 all npt temp ${TEMP} ${TEMP} ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P}

timestep        ${DT}
run             ${NSTEPS}

write_data      eq.lmp
write_restart   eq.restart
