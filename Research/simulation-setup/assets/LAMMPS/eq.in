variable        NSTEPS          equal 50000
variable        THERMO_FREQ     equal 10
variable        DUMP_FREQ       equal 100
variable        TEMP            equal 300.0      # K
variable        PRES            equal 0.0        # bar
variable        TAU_T           equal 0.1        # ps
variable        TAU_P           equal 0.5        # ps
variable        TIME_STEP       equal 0.002      # ps

units           metal
boundary        p p p
atom_style      atomic

read_data       conf.lmp
change_box      all triclinic

# For DeePMD (se_e2_a or other)
# pair_style      deepmd PLACE-HOLDER
# pair_coeff      * *

# For DeePMD (DPA4C)
# atom_modify map yes
# pair_style  deepmd PLACE-HOLDER
# pair_coeff  * * O H

# For MACE
# pair_style      mliap unified PLACE-HOLDER 0
# pair_coeff      * * Pt Pb Ti O

mass            1 PLACE-HOLDER

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

thermo_style    custom step time temp pe ke etotal pxx pyy pzz pxy pxz pyz press cella cellb cellc cellalpha cellbeta cellgamma vol
thermo          ${THERMO_FREQ}

dump            1 all custom ${DUMP_FREQ} traj.lammpstrj id type x y z
dump_modify     1 sort id

velocity        all create ${TEMP} 443428 
fix             1 all npt temp ${TEMP} ${TEMP} ${TAU_T} aniso ${PRES} ${PRES} ${TAU_P} 

timestep        ${TIME_STEP}
run             ${NSTEPS}

write_data      eq.lmp
write_restart   eq.restart